# JWT API는 인증 없는 요청에 401을 주고, 공개 호스트는 스캐너 4xx가 많다.
# Enhanced health가 이 4xx를 Severe로 집계하면 Rolling 배포가 중단된다.
# ALB는 계속 GET /health == 200만 본다. 5xx는 헬스에 그대로 반영한다.
option_settings:
  aws:elasticbeanstalk:healthreporting:system:
    ConfigDocument: '{"Version":1,"CloudWatchMetrics":{"Instance":{},"Environment":{}},"Rules":{"Environment":{"Application":{"ApplicationRequests4xx":{"Enabled":false}},"ELB":{"ELBRequests4xx":{"Enabled":false}}}}}'
